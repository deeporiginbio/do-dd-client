                            "retain_waters": {
                                "description": "Whether water molecules were retained in the system",
                                "type": "boolean",
                                "x-data-type": "PreparedSystem.retain_waters",
                                "x-display-name": "Retain Waters"
                            },
                            "solvation_xml_ligand1_file_path": {
                                "description": "Path to the solvation XML file for the first ligand",
