                        "minItems": 3,
                        "type": "array",
                        "x-display-name": "Box Size",
                        "x-user-input": true
                    },
                    "ligand1": {
                        "description": "First ligand structure for system preparation",
                        "properties": {
                            "file_path": {
                                "description": "Path to the ligand SDF file",
                                "format": "file",
                                "type": "string",
                                "x-data-type": "Ligand.file_path",
                                "x-deeporigin-path": "/deeporigin/inputs/ligand.sdf"
                            },
                            "id": {
                                "description": "Ligand ID",
                                "type": "string",
                                "x-data-type": "Ligand.id"
                            }
                        },
                        "required": [
                            "file_path"
                        ],
                        "type": "object",
                        "x-data-type": "Ligand"
                    },
                    "ligand2": {
                        "description": "Second ligand for RBFE system preparation. When provided, runs RBFE prep instead of ABFE.",
                        "properties": {
                            "file_path": {
                                "description": "Path to the ligand SDF file",
                                "format": "file",
                                "type": "string",
                                "x-data-type": "Ligand.file_path",
                                "x-deeporigin-path": "/deeporigin/inputs/ligand2.sdf"
                            },
                            "id": {
                                "description": "Ligand ID",
                                "type": "string",
                                "x-data-type": "Ligand.id"
                            }
                        },
                        "required": [
                            "file_path"
                        ],
                        "type": "object",
                        "x-data-type": "Ligand"
                    },
                    "padding": {
                        "description": "Padding distance in nm to use around the system",
                        "type": "number",
                        "x-display-name": "Padding",
                        "x-user-input": true
                    },
                    "protein": {
                        "description": "Protein structure for system preparation",
                        "properties": {
                            "file_path": {
                                "description": "Path to the protein PDB file",
                                "format": "file",
                                "type": "string",
                                "x-data-type": "Protein.file_path",
