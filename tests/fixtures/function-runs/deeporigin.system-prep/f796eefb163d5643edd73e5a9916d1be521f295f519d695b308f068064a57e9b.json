                "properties": {
                    "add_H_atoms": {
                        "description": "Whether to add hydrogen atoms to the ligand",
                        "type": "boolean",
                        "x-display-name": "Add Hydrogen Atoms",
                        "x-user-input": true
                    },
                    "box_size": {
                        "description": "Simulation box dimensions (X, Y, Z) in nm",
